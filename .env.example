# ==============================================================================
# VARIABILI D'AMBIENTE SERVER-SIDE (Esempio segnaposto - NON INSERIRE VALORI REALI)
# ==============================================================================
# Istruzioni:
# Copiare questo file in .env.local per lo sviluppo locale oppure configurare
# le variabili nel pannello dell'hosting di produzione (es. Vercel).
# 
# REGOLE DI SICUREZZA FONDAMENTALI:
# 1. NON aggiungere mai il prefisso NEXT_PUBLIC_ a chiavi segrete: qualsiasi
#    variabile con NEXT_PUBLIC_ viene compilata nel bundle JavaScript inviato al browser.
# 2. NON versionare mai credenziali reali in git o file pubblici.
# 3. La chiave server (service-role) bypassa le regole RLS di Supabase su tutto il DB.
#    Sebbene la query sia filtrata, se il server viene compromesso la chiave conferisce
#    privilegi amministrativi ampi. Valutare l'attivazione della funzione RPC
#    'verify_certificate_public' (migration 002) per limitare i privilegi.

# --- SUPABASE BACKEND (SERVER-SIDE ONLY) ---
# URL dell'istanza Supabase (es. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Chiave segreta server-side (Service Role / Secret key)
# Utilizzata ESCLUSIVAMENTE dal codice server Next.js (mai inviata al client).
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# --- SCHEMA TABELLA CERTIFICATI (VALIDATI TRAMITE ALLOWLIST) ---
# Se non specificati, verranno utilizzati i default dello schema reale.
# Valori ammessi per CERT_DB_TABLE: certificates
CERT_DB_TABLE=certificates
# Valori ammessi per CERT_DB_CODE_COLUMN: certificate_id
CERT_DB_CODE_COLUMN=certificate_id
# Valori ammessi per CERT_DB_STATUS_COLUMN: status
CERT_DB_STATUS_COLUMN=status
# Valori ammessi per CERT_DB_DATE_COLUMN: date
CERT_DB_DATE_COLUMN=date
# Valori ammessi per CERT_DB_COURSE_COLUMN: course_type
CERT_DB_COURSE_COLUMN=course_type

# --- RATE LIMITING SERVER-SIDE ---
# NOTA ARCHITETTURALE: Il rate limiter integrato in Node.js è in-memory per singolo processo.
# In un deployment Serverless multi-istanza (Vercel/Lambda/Cloud Run), la memoria non è condivisa.
# Per una protezione globale efficace, configurare regole di Rate Limiting sul WAF (Cloudflare)
# oppure collegare un database condiviso (es. Upstash Redis / Vercel KV).
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60
